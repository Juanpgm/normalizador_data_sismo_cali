rules_version = '2';

// Reglas Firestore de dagma-85aad.
// Solo abren las colecciones del cruce criticos<->survey; todo lo demas queda
// bloqueado (default), asi la app dagma-capture (que escribe server-side con
// admin SDK, saltandose reglas) no se ve afectada.
service cloud.firestore {
  match /databases/{database}/documents {

    // Registro del cruce: cualquiera lo LEE (dashboard publico); solo el equipo
    // aprovisionado (custom claim pmu==true) puede EDITAR, y unicamente los campos
    // de gestion (no los hechos del cruce). Un registro espontaneo por el apiKey
    // publico queda en solo-lectura por no tener el claim. Crear/borrar es
    // exclusivo del pipeline server-side (admin SDK, se salta las reglas).
    match /cruce_criticos_survey/{doc} {
      allow read: if true;
      allow update: if request.auth != null && request.auth.token.pmu == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['gestion_estado', 'gestion_asignado_a', 'gestion_nota',
                       'gestion_despacho_id', 'gestion_entidad', 'gestion_fecha',
                       'gestion_actualizado_utc', 'gestion_actualizado_por']);
      allow create, delete: if false;
    }

    // Resumen: lectura publica, escritura solo server-side.
    match /_meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Despachos (cuadrillas asignadas a zonas): lectura publica; el equipo
    // aprovisionado tiene CRUD completo (crear/editar/eliminar) para gestionar.
    match /despachos/{doc} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.pmu == true;
    }

    // Directorio de líderes (nombre + teléfono) para autocompletar asignaciones.
    match /lideres/{doc} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.pmu == true;
    }

    // Inspecciones del equipo de Israel (survey remapeado a EDE Cali): lectura
    // publica para el dashboard; crear/editar/borrar solo server-side (admin SDK,
    // via subir_israel_firebase.py). Coleccion SEPARADA de inspections.json.
    match /inspecciones_israel/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Resumen de la corrida de Israel: lectura publica, escritura server-side.
    match /_meta_israel/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Formulario de campo ATC-20 (formulario/) ----

    // Un usuario autenticado solo cuenta como inspector si tiene perfil.
    function isInspector() {
      return exists(/databases/$(database)/documents/inspectores/$(request.auth.uid));
    }

    // Perfil de inspector: cada quien lee solo su doc; solo puede actualizar
    // su propio doc, unicamente el campo consecutivo, y solo incrementandolo
    // en exactamente 1 (transaccion de generacion de codigo).
    match /inspectores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consecutivo'])
        && request.resource.data.consecutivo is int
        && request.resource.data.consecutivo == resource.data.consecutivo + 1;
      allow create, delete: if false; // solo consola/admin
    }

    // Evaluaciones ATC-20: crear solo inspectores registrados y a nombre
    // propio; leer solo inspectores; nunca actualizar ni borrar (las
    // reinspecciones son un doc nuevo).
    match /evaluaciones/{id} {
      allow create: if isInspector()
        && request.resource.data.inspector.uid == request.auth.uid;
      allow read: if isInspector();
      allow update, delete: if false;
    }

    // Resto: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
