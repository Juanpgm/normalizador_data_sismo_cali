    {"id": "ais_t3_13_riesgo_estructural", "tipo": "criterio_norma", "nombre": "Riesgo estructural por severidad y extension del dano", "descripcion": "Dano severo en >15% de elementos verticales o >20% de horizontales: riesgo muy alto (peligro de colapso); severo 5-15% o fuerte 10-30%: riesgo alto (no habitable)", "fuente": {"doc": "AIS-manual", "ref": "Tabla 3-13, pags 49-50"}},
    {"id": "ais_t3_22_habitabilidad", "tipo": "criterio_norma", "nombre": "Regla de habitabilidad por combinacion de 4 riesgos", "descripcion": "Peligro de colapso (Rojo) con 1+ riesgo muy alto o 2+ riesgos altos; No habitable (Naranja) con 1+ riesgo alto", "fuente": {"doc": "AIS-manual", "ref": "Tabla 3-22, pag 60"}},
    {"id": "ais_t3_2_estabilidad", "tipo": "criterio_norma", "nombre": "Riesgo por estabilidad global", "descripcion": "Colapso total o parcial >50% o inclinacion notable: riesgo muy alto; colapso parcial 5-50%: alto", "fuente": {"doc": "AIS-manual", "ref": "Tabla 3-2, pags 27-28"}},
    {"id": "ais_t3_3_geotecnico", "tipo": "criterio_norma", "nombre": "Riesgo geotecnico", "descripcion": "Fallas severas de cimentacion, hundimiento o inclinacion: riesgo muy alto", "fuente": {"doc": "AIS-manual", "ref": "Tabla 3-3, pag 32"}},
    {"id": "ais_t3_12_saturacion", "tipo": "criterio_norma", "nombre": "Elementos de saturacion", "descripcion": "Dano severo en muros de carga, columnas o nudos satura el dano global de la edificacion", "fuente": {"doc": "AIS-manual", "ref": "Tabla 3-12, pag 59"}},
    {"id": "ais_t3_21_no_estructural", "tipo": "criterio_norma", "nombre": "Riesgo no estructural", "descripcion": "Danos severos generalizados o elementos en peligro de caer: riesgo alto; no genera colapso por si solo", "fuente": {"doc": "AIS-manual", "ref": "Tabla 3-21, pags 59-60"}},
    {"id": "ais_demolicion_experto", "tipo": "criterio_norma", "nombre": "Recomendacion de demolicion requiere experticia", "descripcion": "Posible demolicion solo ante riesgo inminente para vecinos o imposibilidad de recuperacion sin dudas, y por evaluador con experiencia en patologia", "fuente": {"doc": "AIS-manual", "ref": "pags 27/49"}},
    {"id": "nsr10_a10_10_1_reparar_vs_demoler", "tipo": "criterio_norma", "nombre": "Reparar vs demoler: factibilidad tecnica", "descripcion": "Edificaciones con danos moderados a severos se evaluan para establecer si es tecnicamente factible repararlas; provee criterios para designarlas a demolicion total", "fuente": {"doc": "NSR-10", "ref": "A.10.10.1, pag 126"}},
    {"id": "nsr10_a10_10_1_2_alcance_dano", "tipo": "criterio_norma", "nombre": "Alcance de la reparacion segun tipo de dano", "descripcion": "Dano solo no estructural se repara por A.9; dano estructural exige evaluacion general y reparar los elementos danados mas los necesarios por resistencia y deriva", "fuente": {"doc": "NSR-10", "ref": "A.10.10.1.2, pags 126-127"}},
    {"id": "nsr10_a10_4_3_4_conservacion", "tipo": "criterio_norma", "nombre": "Resistencia efectiva reducida por estado de conservacion", "descripcion": "Resistencia efectiva = existente x phi_c x phi_e; calidad/conservacion mala reduce a 0.6", "fuente": {"doc": "NSR-10", "ref": "A.10.4.3.4 Tabla A.10.4-1, pag 121"}},

